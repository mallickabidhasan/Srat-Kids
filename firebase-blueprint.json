{
  "entities": {
    "Subscriber": {
      "title": "Newsletter Subscriber",
      "description": "A user who has subscribed to the newsletter.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the subscriber."
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user subscribed."
        }
      },
      "required": ["email", "subscribedAt"]
    },
    "VisitorCount": {
      "title": "Visitor Count",
      "description": "A simple counter for website visitors.",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "The total number of visitors."
        }
      },
      "required": ["count"]
    },
    "AdmissionApplication": {
      "title": "Admission Application",
      "description": "A student's application for admission.",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "fatherName": { "type": "string" },
        "motherName": { "type": "string" },
        "schoolName": { "type": "string" },
        "className": { "type": "string" },
        "mobile": { "type": "string" },
        "religion": { "type": "string" },
        "shift": { "type": "string" },
        "studentEmail": { "type": "string", "format": "email" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentName", "mobile", "submittedAt"]
    },
    "ScholarshipApplication": {
      "title": "Scholarship Application",
      "description": "A student's application for the scholarship festival.",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "className": { "type": "string" },
        "studentNameBn": { "type": "string" },
        "studentNameEn": { "type": "string" },
        "fatherNameBn": { "type": "string" },
        "motherNameBn": { "type": "string" },
        "village": { "type": "string" },
        "postOffice": { "type": "string" },
        "upazila": { "type": "string" },
        "district": { "type": "string" },
        "mobile": { "type": "string" },
        "religion": { "type": "string" },
        "nationality": { "type": "string" },
        "isAgreed": { "type": "boolean" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "senderNumber": { "type": "string" },
        "trxId": { "type": "string" },
        "paymentSubmittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolName", "studentNameBn", "mobile", "submittedAt"]
    }
  },
  "firestore": {
    "subscribers": {
      "schema": "Subscriber",
      "description": "Collection of newsletter subscribers."
    },
    "metadata": {
      "schema": "VisitorCount",
      "description": "Global metadata including visitor counts."
    },
    "admissions": {
      "schema": "AdmissionApplication",
      "description": "Collection of student admission applications."
    },
    "scholarship_applications": {
      "schema": "ScholarshipApplication",
      "description": "Collection of scholarship festival applications."
    }
  }
}
